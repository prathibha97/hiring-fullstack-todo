{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "api#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "CLIENT_URL", "NODE_ENV", "MONGODB_URI"]
    },
    "api#test": {
      "cache": false,
      "env": ["MONGODB_TEST_URI", "CLIENT_URL", "NODE_ENV"]
    }
  }
}
