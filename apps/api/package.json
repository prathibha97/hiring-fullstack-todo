{
  "name": "api",
  "packageManager": "yarn@4.17.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "5",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "5",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "10.9.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
